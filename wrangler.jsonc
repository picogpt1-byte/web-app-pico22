{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-pico22",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b9cf6ff8-84b6-49f4-87cc-861e980a65ee","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "19fbdc63cad24d20a70367d4a5f65396" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
